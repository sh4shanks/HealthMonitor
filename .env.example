# ==============================================================================
# Release Health Monitor - Environment Configuration
# ==============================================================================
# Copy this file to `.env` to configure local settings.
# None of these variables contain secrets. Do NOT commit real API secrets.

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION (Backend)
# ------------------------------------------------------------------------------
# Port for the unified server (default: 3000)
PORT=3000

# Environment mode: 'development' or 'production' (default: development)
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. DIAGNOSTICS & RELEASE DRILLS (Backend)
# ------------------------------------------------------------------------------
# Whether intentional diagnostic endpoints (/api/errors/*) are enabled.
# Optional. Default: 'true' in development, 'false' in production.
# Set to 'true' in production only if you intentionally want to run verification drills.
ENABLE_TEST_ERRORS=true

# ------------------------------------------------------------------------------
# 3. CORS & SECURITY CONFIGURATION (Backend)
# ------------------------------------------------------------------------------
# Allowed frontend origin in production (default: same-origin or http://localhost:3000).
# In development, all origins are permitted.
FRONTEND_URL=http://localhost:3000

# Rate limiting window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Rate limiting maximum requests per window per IP (default: 300)
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# 4. SENTRY OBSERVABILITY (Optional)
# ------------------------------------------------------------------------------
# Backend Sentry DSN (leave empty if not reporting to Sentry cloud)
SENTRY_DSN=

# Release identifier matching your Git tag or version
SENTRY_RELEASE=release-health-monitor@1.1.1

# ------------------------------------------------------------------------------
# 5. FRONTEND CONFIGURATION (Vite Client - prefixed with VITE_)
# ------------------------------------------------------------------------------
# Base API URL. Leave empty to use relative paths (/api) with the unified server.
# Set only if backend is hosted on a completely separate domain.
VITE_API_URL=

# Frontend Sentry DSN for browser tracing & session replay
VITE_SENTRY_DSN=

# Frontend Sentry release identifier
VITE_SENTRY_RELEASE=release-health-monitor@1.1.1
